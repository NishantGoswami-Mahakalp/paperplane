#===========================================
# Plane API Production Environment Variables
#===========================================

#===========================================
# Debug (0 for production)
#===========================================
DEBUG=0

#===========================================
# CORS
#===========================================
CORS_ALLOWED_ORIGINS=http://YOUR_VPS_IP,https://your-domain.com

#===========================================
# Database Settings
#===========================================
POSTGRES_USER=plane
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_HOST=plane-db
POSTGRES_DB=plane
POSTGRES_PORT=5432
DATABASE_URL=postgresql://plane:CHANGE_ME_STRONG_PASSWORD@plane-db:5432/plane

#===========================================
# Redis Settings
#===========================================
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/

#===========================================
# RabbitMQ Settings
#===========================================
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ_VHOST=plane

#===========================================
# AWS/MinIO Settings
#===========================================
AWS_REGION=
AWS_ACCESS_KEY_ID=CHANGE_ME_AWS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880
SIGNED_URL_EXPIRATION=3600

#===========================================
# MinIO
#===========================================
USE_MINIO=1

#===========================================
# URLs
#===========================================
WEB_URL=http://YOUR_VPS_IP
ADMIN_BASE_URL=http://localhost:3001
ADMIN_BASE_PATH=/god-mode
SPACE_BASE_URL=http://localhost:3002
SPACE_BASE_PATH=/spaces
APP_BASE_URL=http://localhost:3000
APP_BASE_PATH=
LIVE_BASE_URL=http://localhost:3100
LIVE_BASE_PATH=/live

#===========================================
# Security
#===========================================
LIVE_SERVER_SECRET_KEY=CHANGE_ME_TO_RANDOM_SECRET

#===========================================
# Cleanup
#===========================================
HARD_DELETE_AFTER_DAYS=60

#===========================================
# SSL
#===========================================
MINIO_ENDPOINT_SSL=0

#===========================================
# Rate Limiting
#===========================================
API_KEY_RATE_LIMIT=60/minute
